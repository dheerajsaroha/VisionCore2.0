# Git attributes for cross-platform compatibility (Windows & Linux)
* text=auto

# Enforce LF for shell scripts and Dockerfiles (CRLF breaks bash and Linux containers)
*.sh text eol=lf
Dockerfile* text eol=lf
*.sql text eol=lf

# Python & config files
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.env* text eol=lf

+*               text=auto
+*.sh            text eol=lf
+Dockerfile*     text eol=lf
+*.Dockerfile    text eol=lf
+*.sql           text eol=lf
+*.py            text eol=lf
